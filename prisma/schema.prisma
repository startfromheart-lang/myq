generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id               String    @id @default(cuid())
  phone            String    @unique
  password         String?
  isVerified       Boolean   @default(false)
  realName         String?
  idCard           String?
  facePhoto        String?
  avatar           String?
  selfEvaluation   String?
  preferredMahjong String
  job              String?
  gender           String?
  city             String?
  skillScore       Float     @default(5.0)
  integrityScore   Float     @default(5.0)
  personalityTags  String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  matchGroups      MatchGroupParticipant[]
  reviewsGiven     Review[]   @relation("Reviewer")
  reviewsReceived  Review[]   @relation("Reviewee")
  payments         Payment[]
  sentMessages     ChatMessage[] @relation("MessageSender")
  shopReviews      ShopReview[]

  @@map("users")
}

model Merchant {
  id               String    @id @default(cuid())
  inviteCode       String    @unique
  businessLicense  String
  legalPersonName  String
  legalPersonId    String
  contractSigned   Boolean   @default(false)
  disclaimerAccepted Boolean @default(false)
  shopName         String
  contactPhone     String
  status           String    @default("pending")
  createdAt        DateTime  @default(now())
  rooms            MahjongRoom[]
  coupons          Coupon[]
  campaigns        Campaign[]

  @@map("merchants")
}

model MahjongRoom {
  id               String    @id @default(cuid())
  merchantId       String
  name             String
  hasToilet        Boolean   @default(false)
  area             Float
  mahjongSize      String
  maxTileCount     Int
  price            Float
  address          String
  latitude         Float?
  longitude        Float?
  images           String
  status           String    @default("active")
  createdAt        DateTime  @default(now())
  merchant         Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orders           Order[]
  shopReviews      ShopReview[]

  @@map("mahjong_rooms")
}

model Order {
  id               String    @id @default(cuid())
  matchGroupId     String    @unique
  roomId           String
  totalAmount      Float
  paymentStatus    String    @default("pending")
  checkinTime      DateTime?
  checkinCode      String?
  createdAt        DateTime  @default(now())
  room             MahjongRoom @relation(fields: [roomId], references: [id])
  matchGroup       MatchGroup  @relation(fields: [matchGroupId], references: [id], onDelete: Cascade)
  payments         Payment[]

  @@map("orders")
}

model Payment {
  id               String    @id @default(cuid())
  userId           String
  orderId          String
  amount           Float
  status           String    @default("pending")
  paymentMethod    String
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id])
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model MatchGroup {
  id               String    @id @default(cuid())
  status           String    @default("matching")
  mahjongType      String
  regionRange      String
  scheduledTime    DateTime?
  duration         Int?
  roomId           String?
  createdAt        DateTime  @default(now())
  participants     MatchGroupParticipant[]
  chatMessages     ChatMessage[]
  order            Order?
  reviews          Review[]

  @@map("match_groups")
}

model MatchGroupParticipant {
  id               String    @id @default(cuid())
  groupId          String
  userId           String
  role             String    @default("member")
  status           String    @default("pending")
  paymentConfirmed Boolean   @default(false)
  group            MatchGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [id])

  @@map("match_group_participants")
}

model ChatMessage {
  id               String    @id @default(cuid())
  groupId          String
  senderId         String
  content          String
  createdAt        DateTime  @default(now())
  group            MatchGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender           User      @relation("MessageSender", fields: [senderId], references: [id])

  @@map("chat_messages")
}

model Review {
  id               String    @id @default(cuid())
  reviewerId       String
  revieweeId       String
  matchGroupId     String
  skillScore       Int
  integrityScore   Int
  personalityTags  String
  content          String?
  createdAt        DateTime  @default(now())
  reviewer         User      @relation("Reviewer", fields: [reviewerId], references: [id])
  reviewee         User      @relation("Reviewee", fields: [revieweeId], references: [id])
  matchGroup       MatchGroup @relation(fields: [matchGroupId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model ShopReview {
  id               String    @id @default(cuid())
  roomId           String
  userId           String
  environmentScore Int
  serviceScore     Int
  cateringScore    Int
  content          String?
  createdAt        DateTime  @default(now())
  room             MahjongRoom @relation(fields: [roomId], references: [id])
  user             User      @relation(fields: [userId], references: [id])

  @@map("shop_reviews")
}

model Coupon {
  id               String    @id @default(cuid())
  merchantId       String
  title            String
  discount         Float
  type             String
  validUntil       DateTime
  usageLimit       Int
  usedCount        Int       @default(0)
  merchant         Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("coupons")
}

model Campaign {
  id               String    @id @default(cuid())
  merchantId       String
  title            String
  description      String
  startDate        DateTime
  endDate          DateTime
  prize            String
  merchant         Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("campaigns")
}

model VerificationCode {
  id               String    @id @default(cuid())
  phone            String
  code             String
  type             String
  expiresAt        DateTime
  createdAt        DateTime  @default(now())

  @@map("verification_codes")
}
